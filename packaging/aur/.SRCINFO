pkgbase = local-stt
	pkgdesc = Dictado local en Linux con faster-whisper/CUDA: Win+F para transcribir y copiar
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/paulmrg-461/local_speech_to_text
	install = local-stt.install
	arch = x86_64
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-hatchling
	makedepends = python-wheel
	depends = python
	depends = python-numpy
	depends = python-pyperclip
	depends = python-soundfile
	depends = python-faster-whisper
	depends = python-sounddevice
	depends = python-text2num
	depends = portaudio
	depends = wl-clipboard
	depends = libnotify
	optdepends = wtype: pegar con Ctrl+V en Wayland (KDE/GNOME)
	optdepends = ydotool: alternativa de auto-pegado (requiere ydotool.service)
	optdepends = xdotool: auto-pegado en X11
	optdepends = wofi: selector de historial (Win+Shift+F)
	optdepends = kdotool: ventana activa exacta en KDE (AUR)
	optdepends = python-openwakeword: manos libres con wake word "hey jarvis" (AUR)
	optdepends = python-onnxruntime-cpu: motor del wake word
	optdepends = python-evdev: push-to-talk (mantener tecla para dictar)
	optdepends = cuda: runtime CUDA para faster-whisper
	optdepends = nvidia-utils: driver NVIDIA
