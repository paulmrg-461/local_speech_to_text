# Maintainer: DevPaul <paulmrg-461>
# local-stt: dictado local (faster-whisper + CUDA) para Wayland.
# Build: makepkg -si  (requiere base-devel y las deps AUR)
pkgname=local-stt
pkgver=0.4.0
pkgrel=1
pkgdesc="Dictado local en Linux con faster-whisper/CUDA: Win+F para transcribir y copiar"
arch=(x86_64)
url="https://github.com/paulmrg-461/local_speech_to_text"
license=(MIT)
install=local-stt.install
depends=(
  python
  # Python deps disponibles en repos oficiales
  python-numpy
  python-pyperclip
  python-soundfile
  # Python deps desde AUR
  python-faster-whisper   # trae python-ctranslate2
  python-sounddevice
  python-text2num
  # Sistema: audio, clipboard y notificaciones
  portaudio
  wl-clipboard
  libnotify
)
optdepends=(
  'wtype: pegar con Ctrl+V en Wayland (KDE/GNOME)'
  'ydotool: alternativa de auto-pegado (requiere ydotool.service)'
  'xdotool: auto-pegado en X11'
  'wofi: selector de historial (Win+Shift+F)'
  'kdotool: ventana activa exacta en KDE (AUR)'
  'python-openwakeword: manos libres con wake word "hey jarvis" (AUR)'
  'python-onnxruntime-cpu: motor del wake word'
  'python-evdev: push-to-talk (mantener tecla para dictar)'
  'python-vosk: wake word con frase propia ("DevPaul", "oye computadora")'
  'gtk4: OSD nativo Wayland'
  'python-gobject: OSD nativo Wayland'
  'gtk4-layer-shell: OSD nativo Wayland (capa overlay)'
  'cuda: runtime CUDA para faster-whisper'
  'nvidia-utils: driver NVIDIA'
)
makedepends=(python-build python-installer python-hatchling python-wheel)

# El tarball de GitHub se descomprime como <repo>-$pkgver, no <pkgname>-$pkgver.
_repo=local_speech_to_text

source=(
  "$url/archive/refs/tags/v$pkgver/$pkgname-$pkgver.tar.gz"
  "https://files.pythonhosted.org/packages/af/eb/ff4b8c503fa1f1796679dce648854d58751982426e4e4b37d6fce49d259c/nvidia_cublas_cu12-12.6.4.1-py3-none-manylinux2014_x86_64.manylinux_2_17_x86_64.whl"
)
noextract=("nvidia_cublas_cu12-12.6.4.1-py3-none-manylinux2014_x86_64.manylinux_2_17_x86_64.whl")
sha256sums=(
  '12472e962153761152253844083d1d8b33fb731bbd5a394d09dd785b1dfd3b21'
  '08ed2686e9875d01b58e3cb379c6896df8e76c75e0d4a7f7dace3d7b6d9ef8eb'
)

build() {
  cd "$_repo-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_repo-$pkgver"

  # 1) Wheel del paquete (site-packages + /usr/bin/local-stt)
  python -m installer --destdir="$pkgdir" dist/*.whl

  # 2) Unit systemd --user y script de atajos: `local-stt setup` los busca
  #    en /usr/lib/systemd/user y /usr/share/local-stt cuando no hay repo.
  install -Dm644 packaging/aur/local-stt.service \
    "$pkgdir/usr/lib/systemd/user/local-stt.service"
  install -Dm755 scripts/setup-hotkey.sh \
    "$pkgdir/usr/share/local-stt/setup-hotkey.sh"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # 3) cuBLAS 12 (el wheel de PyPI): ctranslate2 está compilado contra CUDA 12
  #    pero Arch instala CUDA 13; el daemon precarga estas .so.12 con ctypes
  #    desde /usr/lib/local-stt/cublas (ver src/local_speech_to_text/cuda_libs.py).
  local whl="$srcdir/nvidia_cublas_cu12-12.6.4.1-py3-none-manylinux2014_x86_64.manylinux_2_17_x86_64.whl"
  bsdtar -xf "$whl" -C "$srcdir" nvidia/cublas/lib/libcublas.so.12 nvidia/cublas/lib/libcublasLt.so.12
  install -Dm755 "$srcdir/nvidia/cublas/lib/libcublas.so.12" \
    "$pkgdir/usr/lib/local-stt/cublas/libcublas.so.12"
  install -Dm755 "$srcdir/nvidia/cublas/lib/libcublasLt.so.12" \
    "$pkgdir/usr/lib/local-stt/cublas/libcublasLt.so.12"
}
