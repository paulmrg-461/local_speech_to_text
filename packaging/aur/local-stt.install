post_install() {
  echo ""
  echo "local-stt instalado. Próximos pasos:"
  echo "  1. local-stt setup   (modelo, atajo Win+F, servicio systemd --user)"
  echo "  2. local-stt doctor  (diagnóstico: GPU, mic, clipboard)"
  echo ""
  echo "Config: ~/.config/local-stt/config.toml (model = large-v3-turbo por defecto)"
  echo "KDE Plasma 6: cierra sesión y vuelve a entrar para que Win+F aplique."
}

post_upgrade() {
  echo "local-stt actualizado. Reinicia el daemon:"
  echo "  systemctl --user restart local-stt"
}

pre_remove() {
  echo "Deteniendo daemon (si corre):"
  systemctl --user disable --now local-stt 2>/dev/null || true
  echo "Tus datos (~/.config/local-stt) se conservan; borra con: rm -rf ~/.config/local-stt"
}
