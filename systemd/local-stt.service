[Unit]
Description=Local STT Daemon (RTX 5070) - Win+F dictado local
After=graphical-session.target pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=%h/Documents/dev_projects/DevPaul/local_speech_to_text/.venv/bin/local-stt daemon
Restart=on-failure
RestartSec=3
Environment=LOCAL_STT_MODEL=large-v3-turbo
Environment=LOCAL_STT_DEVICE=cuda
Environment=LOCAL_STT_COMPUTE=float16
Environment=LOCAL_STT_LANG=es

[Install]
WantedBy=default.target
