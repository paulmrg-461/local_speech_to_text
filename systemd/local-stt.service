[Unit]
Description=Local STT Daemon (RTX 5070) - Win+F dictado
After=graphical-session.target pipewire.service

[Service]
Type=simple
# La ruta absoluta se ajusta al instalar (scripts/install.sh copia este archivo
# a ~/.config/systemd/user/). La config se lee de ~/.config/local-stt/config.toml
ExecStart=%h/Documents/dev_projects/DevPaul/local_speech_to_text/.venv/bin/local-stt daemon
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/local-stt/config.env

[Install]
WantedBy=default.target
